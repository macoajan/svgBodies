{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["es2022", "dom", "dom.iterable"],
    "paths": { "@shared/*": ["../server/public/*"] }
  },
  "include": ["src/**/*.d.ts", "src/**/*.js", "src/**/*.jsx"]
}
